# Detect ICMP Ping sweep (reconnaissance)
alert icmp any any -> $HOME_NET any (msg:"ICMP Ping Sweep Detected"; itype:8; threshold: type both, track by_src, count 5, seconds 2; sid:1000001; rev:1;)

# Detect Nmap SYN scan
alert tcp any any -> $HOME_NET any (msg:"Nmap SYN Scan Detected"; flags:S; threshold: type both, track by_src, count 20, seconds 1; sid:1000002; rev:1;)

# Detect SSH brute force
alert tcp any any -> $HOME_NET 22 (msg:"SSH Brute Force Attempt"; flow:to_server; threshold: type both, track by_src, count 5, seconds 60; sid:1000003; rev:1;)

# Detect HTTP to suspicious user agent
alert http any any -> any any (msg:"Suspicious User-Agent Detected"; http.user_agent; content:"sqlmap"; nocase; sid:1000004; rev:1;)

# Detect DNS query to known bad domain pattern
alert dns any any -> any any (msg:"Suspicious DNS Lookup"; dns.query; content:".tk"; endswith; sid:1000005; rev:1;)

# Detect port scan (many ports hit from one source)
alert tcp any any -> $HOME_NET any (msg:"Possible Port Scan"; flags:S; threshold: type both, track by_src, count 30, seconds 5; sid:1000006; rev:1;)
